<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="Theme.ReshamKrishi"
        parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowSplashScreenBackground">#2F8F00</item>
        <item name="windowSplashScreenAnimatedIcon">
            @drawable/app_logo_resham_krishi
        </item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <style name="BottomNavIndicator">

        <item name="android:width">48dp</item>
        <item name="android:height">48dp</item>

        <item name="shapeAppearance">
            @style/ShapeAppearance.Material3.Corner.Full
        </item>

        <item name="android:color">@color/primary_green</item>

    </style>

    <!-- Bottom Navigation Text -->
    <style name="BottomNavTextInactive">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="BottomNavTextActive">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="CustomBottomNavIndicator">
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.BottomNavIndicator</item>
        <item name="android:color">@color/border_background</item>
    </style>

    <style name="ShapeAppearance.BottomNavIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

</resources>