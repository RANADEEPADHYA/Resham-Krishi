<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/check_email"
    android:paddingTop="60dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="60dp">

    <!-- Button -->
    <LinearLayout
        android:id="@+id/btnBack"
        android:layout_width="100dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:elevation="10dp">

        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_left_arrow_green" />

    </LinearLayout>

    <!-- Top Illustration -->
    <ImageView
        android:id="@+id/imgEmail"
        android:layout_width="300dp"
        android:layout_height="250dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/check_email_img" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:text="Check Your Email"
        android:textColor="@color/primary_green"
        android:textSize="30sp"
        android:fontFamily="@font/poppins_bold" />

    <!-- Description -->
    <TextView
        android:id="@+id/txtDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="We’ve sent a password reset link to example@email.com"
        android:textColor="@color/text_dark"
        android:textSize="18sp" />

    <!-- Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_circle_light_green"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:elevation="5dp">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_info" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="The link will expire in 45 minutes for security reason."
            android:textColor="@color/primary_green"
            android:fontFamily="@font/poppins_regular"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Open Email Button -->
    <Button
        android:id="@+id/btnOpenEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:layout_marginTop="26dp"
        app:backgroundTint="@null"
        android:background="@drawable/bg_button_green"
        android:text="Open Email App"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:fontFamily="@font/poppins_bold"/>

    <!-- Info Card -->
    <LinearLayout
        android:id="@+id/layoutResend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_white"
        android:elevation="5dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/txtResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resend_link"
            android:textColor="@color/primary_green"
            android:textSize="24sp"
            android:fontFamily="@font/poppins_bold" />

        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="   (00:45)"
            android:textColor="@color/accent_red"
            android:textSize="22sp"
            android:fontFamily="@font/poppins_bold" />

    </LinearLayout>

    <!-- Bottom Text -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back to "
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_regular"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/txtSignIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sign_in"
            android:paddingStart="10dp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/accent_red"
            android:textSize="18sp"/>
    </LinearLayout>

</LinearLayout>
