<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/forget_pw_bg"
    android:paddingTop="60dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="60dp">

    <!-- Button -->
    <LinearLayout
        android:id="@+id/btnBack"
        android:layout_width="100dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:elevation="10dp">

        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_left_arrow_green" />

    </LinearLayout>

    <!-- Silkworm Image -->
    <ImageView
        android:id="@+id/imgSilkworm"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/intro_imag"
        android:background="@drawable/image_rounded_bg"
        android:outlineProvider="background"
        android:clipToOutline="true"/>

    <!-- Logo -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_logo"
        android:background="@drawable/circle_bg_all"
        android:src="@drawable/app_logo_resham_krishi" />

    <!-- App Name -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/primary_green"
        android:textSize="36sp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="@string/app_description"
        android:textColor="@color/light_green"
        android:textSize="22sp" />

    <!-- Small Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="🌿   Healthy Worms, Better Yield   🌿"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_regular"/>

    <!-- Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:elevation="5dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot Password?"
            android:textColor="@color/primary_green"
            android:textSize="28sp"
            android:fontFamily="@font/poppins_bold" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Don’t worry! Enter your registered email address and we’ll send you a link to reset your password."
            android:textColor="@color/light_text"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"/>

        <!-- Email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/language_item_selector"
            android:gravity="center_vertical"
            android:padding="5dp"
            android:layout_marginTop="5dp">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_mail" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:hint="@string/email_des"
                android:paddingStart="10dp"
                android:textSize="18sp"
                android:textColor="#000000"
                android:textColorHint="@color/light_text"
                android:inputType="textEmailAddress"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>

        <!-- Sign In Button -->
        <Button
            android:id="@+id/btnSendResetLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_button_green"
            android:text="Send Reset Link"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:padding="5dp"
            android:fontFamily="@font/poppins_bold"
            android:textSize="28sp"
            android:elevation="5dp"
            app:backgroundTint="@null"/>

        <!-- Sign Up -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remember your password? "
                android:textColor="@color/light_text"
                android:fontFamily="@font/poppins_regular"/>

            <TextView
                android:id="@+id/txtSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sign_in"
                android:paddingStart="10dp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/accent_red" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>