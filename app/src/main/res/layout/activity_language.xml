<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/language_screen"
        android:scaleType="centerCrop"/>

    <!-- Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_overlay"/>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="70dp"
        android:paddingEnd="20dp"
        android:paddingStart="20dp"
        android:paddingBottom="40dp">


        <!-- App Title -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:background="@drawable/circle_bg_all"
            android:contentDescription="@string/app_logo"
            android:src="@drawable/app_logo_resham_krishi" />

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="36sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/text_dark"
            android:layout_gravity="center"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_description"
            android:textColor="@color/primary_green"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_gravity="center"/>

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/language_text"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/poppins_regular"/>
        <!-- Language Card -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Icon -->
                    <LinearLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:background="@drawable/bg_circle_light_green"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/ic_language"
                            app:tint="@color/primary_green" />
                    </LinearLayout>

                    <!-- Text -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choose_your_language"
                            android:textColor="@color/primary_green"
                            android:textSize="20sp"
                            android:fontFamily="@font/poppins_bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/select_your_preferred_language_to_continue"
                            android:textColor="@color/gray_text"
                            android:textSize="16sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Scrollable Languages -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="25dp"
                    android:scrollbars="vertical"
                    android:scrollbarStyle="insideInset"
                    android:scrollbarThumbVertical="@drawable/custom_scrollbar_thumb"
                    android:scrollbarTrackVertical="@drawable/custom_scrollbar_track"
                    android:scrollbarSize="10dp"
                    android:fadeScrollbars="false"
                    android:overScrollMode="never"
                    tools:ignore="NestedWeights,RtlSymmetry">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- English -->
                        <LinearLayout
                            android:id="@+id/langEnglish"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/language_item_selector"
                            android:elevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <!-- Language Icon -->
                            <TextView
                                android:id="@+id/iconEnglish"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/language_icon_selector"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="center"
                                android:text="@string/en"
                                android:textColor="@color/language_text_selector"
                                android:textSize="20sp" />

                            <!-- Language Name -->
                            <TextView
                                android:id="@+id/textEnglish"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/english"
                                android:textColor="@color/primary_green"
                                android:textSize="22sp" />

                            <!-- Selected Circle -->
                            <FrameLayout
                                android:id="@+id/checkEnglish"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/check_selector">

                                <ImageView
                                    android:id="@+id/checkIconEnglish"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="visible"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                        </LinearLayout>

                        <!-- Hindi -->
                        <LinearLayout
                            android:id="@+id/langHindi"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginBottom="8dp"
                            android:elevation="2dp"
                            android:background="@drawable/language_item_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:id="@+id/iconHindi"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/language_icon_selector"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="center"
                                android:text="@string/hindi_icon"
                                android:textColor="@color/language_text_selector"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/textHindi"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/hindi"
                                android:textColor="@color/primary_green"
                                android:textSize="22sp" />

                            <FrameLayout
                                android:id="@+id/checkHindi"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/check_selector">

                                <ImageView
                                    android:id="@+id/checkIconHindi"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                        </LinearLayout>

                        <!-- Bengali -->
                        <LinearLayout
                            android:id="@+id/langBengali"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginBottom="8dp"
                            android:elevation="2dp"
                            android:background="@drawable/language_item_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:id="@+id/iconBengali"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/language_icon_selector"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="center"
                                android:text="@string/bengali_icon"
                                android:textColor="@color/language_text_selector"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/textBengali"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/bengali"
                                android:textColor="@color/primary_green"
                                android:textSize="22sp" />

                            <FrameLayout
                                android:id="@+id/checkBengali"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/check_selector">

                                <ImageView
                                    android:id="@+id/checkIconBengali"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                        </LinearLayout>

                        <!-- Kannada -->
                        <LinearLayout
                            android:id="@+id/langKannada"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginBottom="8dp"
                            android:elevation="2dp"
                            android:background="@drawable/language_item_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:id="@+id/iconKannada"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/language_icon_selector"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="center"
                                android:text="@string/kannada_icon"
                                android:textColor="@color/language_text_selector"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/textKannada"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/kannada"
                                android:textColor="@color/primary_green"
                                android:textSize="22sp" />

                            <FrameLayout
                                android:id="@+id/checkKannada"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/check_selector">

                                <ImageView
                                    android:id="@+id/checkIconKannada"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                        </LinearLayout>

                        <!-- Tamil -->
                        <LinearLayout
                            android:id="@+id/langTamil"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginBottom="8dp"
                            android:elevation="2dp"
                            android:background="@drawable/language_item_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:id="@+id/iconTamil"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/language_icon_selector"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="center"
                                android:text="த"
                                android:textColor="@color/language_text_selector"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/textTamil"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="தமிழ் (Tamil)"
                                android:textColor="@color/primary_green"
                                android:textSize="22sp" />

                            <FrameLayout
                                android:id="@+id/checkTamil"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/check_selector">

                                <ImageView
                                    android:id="@+id/checkIconTamil"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                        </LinearLayout>

                        <!-- Telugu -->
                        <LinearLayout
                            android:id="@+id/langTelugu"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginBottom="8dp"
                            android:elevation="2dp"
                            android:background="@drawable/language_item_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:id="@+id/iconTelugu"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/language_icon_selector"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="center"
                                android:text="తె"
                                android:textColor="@color/language_text_selector"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/textTelugu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="తెలుగు (Telugu)"
                                android:textColor="@color/primary_green"
                                android:textSize="22sp" />

                            <FrameLayout
                                android:id="@+id/checkTelugu"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/check_selector">

                                <ImageView
                                    android:id="@+id/checkIconTelugu"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                        </LinearLayout>

                        <!-- Malayalam -->
                        <LinearLayout
                            android:id="@+id/langMalayalam"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginBottom="8dp"
                            android:elevation="2dp"
                            android:background="@drawable/language_item_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:id="@+id/iconMalayalam"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/language_icon_selector"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="center"
                                android:text="മ"
                                android:textColor="@color/language_text_selector"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/textMalayalam"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="മലയാളം (Malayalam)"
                                android:textColor="@color/primary_green"
                                android:textSize="20sp" />

                            <FrameLayout
                                android:id="@+id/checkMalayalam"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/check_selector">

                                <ImageView
                                    android:id="@+id/checkIconMalayalam"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                        </LinearLayout>

                        <!-- Marathi -->
                        <LinearLayout
                            android:id="@+id/langMarathi"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:elevation="2dp"
                            android:background="@drawable/language_item_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:id="@+id/iconMarathi"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/language_icon_selector"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="center"
                                android:text="म"
                                android:textColor="@color/language_text_selector"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/textMarathi"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="मराठी (Marathi)"
                                android:textColor="@color/primary_green"
                                android:textSize="22sp" />

                            <FrameLayout
                                android:id="@+id/checkMarathi"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/check_selector">

                                <ImageView
                                    android:id="@+id/checkIconMarathi"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                        </LinearLayout>

                    </LinearLayout>

                </ScrollView>

            <!-- Continue Button -->
            <Button
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_green"
                android:text="@string/btn_continue"
                android:textAllCaps="false"
                app:backgroundTint="@null"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:fontFamily="@font/poppins_bold" />

            <!-- Footer -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/poppins_light"
                    android:gravity="center"
                    android:text="@string/footer_language"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp" />

            </LinearLayout>

    </LinearLayout>

</FrameLayout>