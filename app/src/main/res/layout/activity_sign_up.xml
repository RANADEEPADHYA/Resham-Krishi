<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/sign_up_background"
        android:scaleType="centerCrop"/>

    <!-- Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_overlay"
        android:alpha="0.35"/>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|start"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="50dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="45sp">


        <!-- TOP SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/join_the_community"
            android:textAlignment="viewStart"
            android:gravity="start"
            android:textColor="@color/primary_green"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/app_des_2"
            android:textAlignment="viewStart"
            android:gravity="start"
            android:textColor="@color/primary_green"
            android:textSize="30sp" />

        <!-- Sign In Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="583dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/create_your_account"
                android:textColor="@color/primary_green"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/sign_up_des"
                android:textColor="@color/light_text"
                android:textSize="14sp" />

            <!-- Sign Up Button -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="25dp"
                android:layout_weight="1"
                android:fadeScrollbars="false"
                android:overScrollMode="never"
                android:scrollbarSize="10dp"
                android:scrollbarStyle="insideInset"
                android:scrollbarThumbVertical="@drawable/custom_scrollbar_thumb"
                android:scrollbarTrackVertical="@drawable/custom_scrollbar_track"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/full_name"
                        android:textColor="@color/primary_green" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/language_item_selector"
                        android:gravity="center_vertical"
                        android:padding="5dp">

                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/ic_person" />

                        <EditText
                            android:id="@+id/etFullName"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:color/transparent"
                            android:hint="@string/full_name_des"
                            android:inputType="textPersonName"
                            android:paddingStart="10dp"
                            android:textColor="#000000"
                            android:textColorHint="@color/light_text"
                            android:textSize="18sp"
                            android:layout_marginEnd="20dp"/>
                    </LinearLayout>

                    <!-- Phone -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/phone_no"
                        android:textColor="@color/primary_green" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/language_item_selector"
                        android:gravity="center_vertical"
                        android:padding="5dp">

                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/ic_phone" />

                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:color/transparent"
                            android:hint="Enter Your Phone No."
                            android:inputType="phone"
                            android:paddingStart="10dp"
                            android:textColor="#000000"
                            android:textColorHint="@color/light_text"
                            android:textSize="18sp"
                            android:layout_marginEnd="20dp"/>
                    </LinearLayout>

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/email"
                        android:textColor="@color/primary_green" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/language_item_selector"
                        android:gravity="center_vertical"
                        android:padding="5dp">

                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/ic_mail" />

                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:color/transparent"
                            android:hint="@string/email_des"
                            android:inputType="textEmailAddress"
                            android:paddingStart="10dp"
                            android:textColor="#000000"
                            android:textColorHint="@color/light_text"
                            android:textSize="18sp"
                            android:layout_marginEnd="20dp"/>
                    </LinearLayout>


                    <!-- Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/password"
                        android:textColor="@color/primary_green" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/language_item_selector"
                        android:gravity="center_vertical"
                        android:padding="5dp">

                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/ic_password_pw" />

                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="220dp"
                            android:layout_height="48dp"
                            android:background="@android:color/transparent"
                            android:hint="@string/password_des"
                            android:inputType="textPassword"
                            android:paddingStart="10dp"
                            android:textColor="#000000"
                            android:textColorHint="@color/light_text"
                            android:textSize="18sp" />

                        <ImageView
                            android:id="@+id/imgEye"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_eye_closed" />

                    </LinearLayout>

                    <!-- Confirm Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Confirm Password"
                        android:textColor="@color/primary_green" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/language_item_selector"
                        android:gravity="center_vertical"
                        android:padding="5dp"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/ic_password_pw" />

                        <EditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="220dp"
                            android:layout_height="48dp"
                            android:background="@android:color/transparent"
                            android:hint="Confirm Your Password"
                            android:inputType="textPassword"
                            android:paddingStart="10dp"
                            android:textColor="#000000"
                            android:textColorHint="@color/light_text"
                            android:textSize="18sp" />

                        <ImageView
                            android:id="@+id/imgEye_confirm"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_eye_closed" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

            <Button
                app:backgroundTint="@null"
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_button_green"
                android:elevation="5dp"
                android:fontFamily="@font/poppins_bold"
                android:padding="5dp"
                android:text="@string/sign_up"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="@color/light_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="@string/or"
                    android:textColor="@color/light_text"
                    android:textSize="16sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="@color/light_text" />
            </LinearLayout>

            <!-- Google Button -->
            <LinearLayout
                android:id="@+id/btnGoogle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_white"
                android:elevation="3dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_google" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/continue_with_google"
                    android:textColor="@color/primary_green"
                    android:textSize="20dp" />
            </LinearLayout>

            <!-- Sign In -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/already_have_a_account"
                    android:textColor="@color/light_text" />

                <TextView
                    android:id="@+id/txtSignUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingStart="10dp"
                    android:text="@string/sign_in"
                    android:textColor="@color/accent_red" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="top|center">

            <LinearLayout
                android:id="@+id/btnSignInPage"
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:padding="15dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_button_white"
                android:gravity="top|center"
                android:orientation="horizontal"
                android:elevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_in"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/primary_green"
                    android:layout_marginBottom="10dp"
                    android:textSize="28sp"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSignUpPage"
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:layout_marginTop="15dp"
                android:padding="15dp"
                android:background="@drawable/bg_button_green"
                android:gravity="top|center"
                android:orientation="horizontal"
                android:elevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_up"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="10dp"
                    android:textSize="28sp"
                    />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>