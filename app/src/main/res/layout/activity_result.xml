<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:background="@drawable/into_second_background">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="20dp">

        <!-- BACK -->

        <ImageView
            android:id="@+id/btnBack"

            android:layout_width="35dp"
            android:layout_height="35dp"

            android:src="@drawable/ic_left_arrow_green"

            android:padding="6dp"/>

        <!-- TITLE -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Prediction Result"

            android:textSize="26sp"
            android:fontFamily="@font/poppins_bold"

            android:textColor="@color/primary_green"

            android:layout_marginTop="20dp"/>

        <!-- CARD -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:background="#FFFFFF"

            android:padding="20dp"

            android:layout_marginTop="20dp"

            android:elevation="4dp">

            <!-- STATUS -->

            <TextView
                android:id="@+id/txtStatus"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Healthy"

                android:textSize="18sp"
                android:textStyle="bold"

                android:textColor="#4CAF50"/>

            <!-- DISEASE -->

            <TextView
                android:id="@+id/txtDisease"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Disease Name"

                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"

                android:textColor="#000000"

                android:layout_marginTop="12dp"/>

            <!-- CONFIDENCE -->

            <TextView
                android:id="@+id/txtConfidence"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Confidence: 98%"

                android:textSize="18sp"

                android:textColor="#555555"

                android:layout_marginTop="10dp"/>

            <!-- SUMMARY TITLE -->

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Diagnosis Summary"

                android:textSize="20sp"
                android:fontFamily="@font/poppins_bold"

                android:textColor="#000000"

                android:layout_marginTop="20dp"/>

            <!-- SUMMARY -->

            <TextView
                android:id="@+id/txtSummary"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Summary"

                android:textSize="16sp"

                android:textColor="#444444"

                android:layout_marginTop="8dp"/>

            <!-- SYMPTOMS TITLE -->

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Symptoms"

                android:textSize="20sp"
                android:fontFamily="@font/poppins_bold"

                android:textColor="#000000"

                android:layout_marginTop="20dp"/>

            <!-- SYMPTOMS -->

            <TextView
                android:id="@+id/txtSymptoms"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Symptoms"

                android:textSize="16sp"

                android:textColor="#444444"

                android:layout_marginTop="8dp"/>


            <Button
                android:id="@+id/btnDownloadPdf"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:backgroundTint="@null"
                android:text="Download PDF Report"
                android:textSize="24dp"
                android:fontFamily="@font/poppins_bold"
                android:background="@drawable/bg_button_green"
                android:layout_marginTop="24dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>