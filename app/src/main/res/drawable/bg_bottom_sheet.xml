<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background -->
    <solid android:color="@color/border_background"/>

    <!-- Rounded Top -->
    <corners
        android:topLeftRadius="20dp"/>

    <!-- Padding -->
    <padding
        android:top="10dp"
        android:left="15dp"
        android:bottom="30dp"/>

    <!-- Soft Border -->
    <stroke
        android:width="1dp"
        android:color="@color/primary_green"/>

</shape>